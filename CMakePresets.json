{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ASH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "fedora-gcc",
      "displayName": "Fedora / GCC",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "fedora-clang",
      "displayName": "Fedora / Clang",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "fedora-clang-asan",
      "displayName": "Fedora / Clang + ASan + UBSan",
      "inherits": "fedora-clang",
      "cacheVariables": {
        "ASH_SANITIZE": "ON",
        "ASH_WERROR": "ON",
        "ASH_BUILD_PYTHON": "OFF"
      }
    },
    {
      "name": "fedora-clang-python",
      "displayName": "Fedora / Clang + Python bindings",
      "inherits": "fedora-clang",
      "cacheVariables": { "ASH_BUILD_PYTHON": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "fedora-gcc", "configurePreset": "fedora-gcc" },
    { "name": "fedora-clang", "configurePreset": "fedora-clang" },
    { "name": "fedora-clang-asan", "configurePreset": "fedora-clang-asan" },
    { "name": "fedora-clang-python", "configurePreset": "fedora-clang-python" }
  ],
  "testPresets": [
    {
      "name": "fedora-gcc",
      "configurePreset": "fedora-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "fedora-clang",
      "configurePreset": "fedora-clang",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "fedora-clang-asan",
      "configurePreset": "fedora-clang-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "fedora-clang-python",
      "configurePreset": "fedora-clang-python",
      "output": { "outputOnFailure": true }
    }
  ]
}
